# API キーはここ（.env）か OS の環境変数に置く。config.json には書かない。
# .env は .gitignore 済み。OS の環境変数が既にあれば、そちらが優先される。

ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ローカル LLM のサーバー（TabbyAPI など）がキーを求めるとき。providers[].apiKeyEnv にこの名前を書く
# LOCAL_LLM_API_KEY=

# 実行時データの置き場所を変えるとき（既定は data）
# CLIVE_DATA_DIR=
