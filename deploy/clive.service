# Clive を Linux の systemd で常駐させる（docs/deploy.md を参照）
#   sudo cp deploy/clive.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now clive
#   journalctl -u clive -f
[Unit]
Description=Clive (personal AI agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clive
Group=clive
WorkingDirectory=/opt/clive
# API キーは /opt/clive/.env（clive だけが読める権限にする）か EnvironmentFile に書く
EnvironmentFile=-/etc/clive/env
Environment=NODE_ENV=production
Environment=CLIVE_DATA_DIR=/var/lib/clive
ExecStart=/usr/bin/node src/main.ts
Restart=on-failure
RestartSec=5
# 終了時は Clive が実行中の返事とシェルを止めてから終わる
KillMode=mixed
TimeoutStopSec=20

# OS レベルの閉じ込め。Clive のシェル実行のガードは文字列の判定なので、ここで書ける場所を絞っておく
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/clive
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
# ローカル LLM（127.0.0.1）と外部の API・Web につなぐ
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
